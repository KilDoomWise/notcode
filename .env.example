# Корень воркспейса по умолчанию для первого запуска.
# Если не задан — берётся папка, из которой запущен сервер.
# Позже корень меняется без перезапуска через workspace_add / workspace_use.
WORKSPACE_ROOT=C:\path\to\your\project

# Важно: токен, порт, хост, режим и лимиты живут НЕ в .env,
# а в ~/.notcode/config.json — см. `bun run setup` и `bun run status`.
