# NotCode — переменные окружения (все необязательные).
# Скопируй в .env и поменяй под себя. .env в гит не попадает.
#
# Основные настройки (режим, токен, профили) живут в ~/.notcode/config.json,
# а не здесь: переменные ниже только перекрывают его на время запуска.

# Корень воркспейса при первом `bun run setup` (по умолчанию — текущая папка).
# WORKSPACE_ROOT=C:\Users\you\Projects\my-app

# Порт HTTP/SSE-сервера (по умолчанию 3000).
# NOTCODE_PORT=3000

# Адрес прослушивания. По умолчанию 127.0.0.1 — сервер виден только с этой машины.
# 0.0.0.0 выставляет сервер в сеть — делай так только за HTTPS-реверс-прокси.
# NOTCODE_HOST=127.0.0.1

# Уровень логов в stderr: debug | info | warn | error | silent (по умолчанию info).
# stdout никогда не используется под логи: он зарезервирован под stdio-транспорт MCP.
# NOTCODE_LOG_LEVEL=info

# Порт для `bun run e2e` (по умолчанию 3999, чтобы не трогать рабочий сервер).
# E2E_PORT=3999
